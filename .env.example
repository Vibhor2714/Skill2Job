# ==============================================================================
# Skills2Job — Environment Configuration Example
# Copy this file to `.env` (or `backend/.env` / `frontend/.env.local`) and fill
# in values as needed. Never commit real `.env` files or secrets to Git.
# ==============================================================================

# --- Runtime Environment ---
# Set to "production" in deployed environments (requires a custom JWT_SECRET_KEY).
APP_ENV=development

# --- Authentication & Security ---
# Required in production (APP_ENV=production). Use a long random string.
# JWT_SECRET_KEY=replace_with_a_64_char_random_secret

# --- Database ---
# Optional. Defaults to `sqlite:///<repo>/backend/skills2job.db` on Windows & macOS.
# DATABASE_URL=sqlite:///./skills2job.db

# --- CORS (Backend) ---
# Comma-separated allowed frontend origins. Defaults to localhost:3000 & 127.0.0.1:3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend API URL ---
# Used by Next.js (`frontend/src/lib/api.ts`).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# --- AI Mock Interview Evaluator (Optional, Backend-Only) ---
# If omitted, the backend transparently uses the deterministic rubric fallback.
# INTERVIEW_LLM_API_KEY=
# INTERVIEW_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# INTERVIEW_LLM_MODEL=gpt-4o-mini
# INTERVIEW_LLM_TIMEOUT_SECONDS=15

# --- File Uploads ---
# Resume uploads are processed in-memory (no temp disk writes required).
# Max resume file size is 5 MB (PDF, DOCX, TXT).
# UPLOAD_DIR=backend/uploads

# --- OTP Delivery Service ---
# Temporary college-demo mode prints masked OTPs to the backend terminal in development.
# Supported values: console (dev/demo), msg91 (future SMS integration)
OTP_DELIVERY_MODE=console
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Required only when switching OTP_DELIVERY_MODE=msg91 in the future:
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=
